<Window x:Class="GD_ControlCenter_WPF.Views.Dialogs.Platform3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="三维平台控制" Height="260" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Window.Resources>
        <SolidColorBrush x:Key="PurpleThemeBrush" Color="#673ab7" />
        <Style x:Key="PurpleRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource PurpleThemeBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,15,24,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: 状态栏 -->
        <Border Grid.Row="0" Background="#F3E5F5" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="InformationOutline" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource PurpleThemeBrush}"/>
                <TextBlock Text="{Binding CalibrationStatus}" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="#4A148C" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Row 1: 统一的列对齐网格，上下两排共享同一个列结构 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- === 上排：坐标监测 + 自动化校准 === -->

            <!-- 标题行 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="实时坐标监测" Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Opacity="0.6" Margin="0,0,0,12"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                       Text="自动化校准" Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Opacity="0.6" Margin="0,0,0,12"/>

            <!-- 坐标显示 -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="X" FontWeight="Bold" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CurrentX, StringFormat={}{0:F0}}" FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding MaxX, StringFormat=/{0:F0}}" FontSize="12" Opacity="0.6" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Y" FontWeight="Bold" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CurrentY, StringFormat={}{0:F0}}" FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding MaxY, StringFormat=/{0:F0}}" FontSize="12" Opacity="0.6" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Z" FontWeight="Bold" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CurrentZ, StringFormat={}{0:F0}}" FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding MaxZ, StringFormat=/{0:F0}}" FontSize="12" Opacity="0.6" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                </StackPanel>
            </Grid>

            <!-- 自动化校准控件 -->
            <ComboBox Grid.Row="1" Grid.Column="3"
                      ItemsSource="{Binding PeakWavelengths}" SelectedItem="{Binding SelectedPeakWavelength}"
                      materialDesign:HintAssist.Hint="目标波长 (nm)" Width="100"
                      HorizontalAlignment="Left" Margin="0,0,10,0" VerticalAlignment="Center"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

            <Button Grid.Row="1" Grid.Column="4"
                    Command="{Binding StartCalibrationCommand}" Content="开始"
                    Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource PurpleThemeBrush}"
                    BorderBrush="{StaticResource PurpleThemeBrush}" IsEnabled="{Binding !IsCalibrating}"
                    Width="100" Height="36" materialDesign:ButtonAssist.CornerRadius="4"
                    VerticalAlignment="Center"/>

            <!-- === 分隔 === -->

            <!-- === 下排：手动步进调节 === -->

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                       Text="手动步进调节" Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Opacity="0.6" Margin="0,0,0,10"/>

            <Border Grid.Row="4" Grid.Column="0" Background="#10000000" CornerRadius="6" Margin="0,0,20,0" Height="36">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="X轴" GroupName="AxisGroup" IsChecked="{Binding IsXSelected}" Style="{StaticResource PurpleRadioButtonStyle}" Width="65" />
                    <RadioButton Content="Y轴" GroupName="AxisGroup" IsChecked="{Binding IsYSelected}" Style="{StaticResource PurpleRadioButtonStyle}" Width="65"/>
                    <RadioButton Content="Z轴" GroupName="AxisGroup" IsChecked="{Binding IsZSelected}" Style="{StaticResource PurpleRadioButtonStyle}" Width="65"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Grid.Column="1" Background="#10000000" CornerRadius="6" Height="36">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="{materialDesign:PackIcon Kind=Plus}" ToolTip="正向移动" GroupName="DirGroup" IsChecked="{Binding IsDirPositive}" Style="{StaticResource PurpleRadioButtonStyle}" Width="65"/>
                    <RadioButton Content="{materialDesign:PackIcon Kind=Minus}" ToolTip="反向移动" GroupName="DirGroup" IsChecked="{Binding IsDirNegative}" Style="{StaticResource PurpleRadioButtonStyle}" Width="65"/>
                </StackPanel>
            </Border>

            <!-- C2: * 弹性填充，自动将"步长"推到与"自动化校准"对齐的位置 -->

            <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                <TextBlock Text="步长" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14" Opacity="0.8"/>
                <TextBox Text="{Binding StepDistance, UpdateSourceTrigger=PropertyChanged}" Width="80" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MaterialDesignTextBox}"/>
            </StackPanel>

            <Button Grid.Row="4" Grid.Column="4"
                    Command="{Binding MoveCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{StaticResource PurpleThemeBrush}" BorderBrush="{StaticResource PurpleThemeBrush}"
                    Content="移动" Width="100" Height="36" materialDesign:ButtonAssist.CornerRadius="4"
                    VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
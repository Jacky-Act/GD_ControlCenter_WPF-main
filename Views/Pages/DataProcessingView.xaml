<UserControl x:Class="GD_ControlCenter_WPF.Views.Pages.DataProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:helpers="clr-namespace:GD_ControlCenter_WPF.Helpers"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5.5*" />
            <!-- 左列：配置、图表与指标 -->
            <ColumnDefinition Width="4.5*" />
            <!-- 右列：数据表格与底层操作 -->
        </Grid.ColumnDefinitions>

        <!-- 顶部悬浮提示卡片 (不阻挡交互) -->
        <materialDesign:Card Grid.ColumnSpan="2" 
                             HorizontalAlignment="Center" VerticalAlignment="Top" 
                             Margin="0,10,0,0" Padding="16,8"
                             Background="#CC212121"
                             Foreground="White"
                             UniformCornerRadius="4"
                             Panel.ZIndex="100"
                             Visibility="{Binding ShowAlert, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding AlertMessage}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- ================= 左侧列 (视觉与指标) ================= -->
        <Grid Grid.Column="0" Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 顶部栏：元素选择 -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Orientation="Horizontal" Margin="15,10">
                    <materialDesign:PackIcon Kind="GoogleAnalytics" VerticalAlignment="Center" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="数据处理中心" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,20,0"/>

                    <Separator Style="{StaticResource MaterialDesignLightSeparator}" Width="2" Height="24" Margin="0,0,20,0">
                        <Separator.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </Separator.LayoutTransform>
                    </Separator>

                    <TextBlock Text="元素:" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,10,0"/>
                    <ComboBox Width="100" ItemsSource="{Binding ActiveElements}" 
                              SelectedItem="{Binding SelectedElement}" />
                </StackPanel>
            </materialDesign:Card>

            <!-- 2. 中部：校准曲线图 -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <TextBlock Text="{Binding SelectedElement, StringFormat='校准曲线 ({0})'}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="10" Opacity="0.5" Panel.ZIndex="1"/>
                    <Border Background="Black" CornerRadius="8" Margin="8,30,8,8">
                        <ScottPlot:WpfPlot x:Name="CalibrationPlot" />
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- 3. 下部：拟合模型性能分析与操作按钮 -->
            <materialDesign:Card Grid.Row="2" Margin="0,0,0,0" UniformCornerRadius="8" 
                                 Background="{DynamicResource PrimaryHueLightBrush}" 
                                 Foreground="{DynamicResource PrimaryHueLightForegroundBrush}">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：左侧标题，右侧操作按钮 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="拟合模型性能" FontWeight="Bold" VerticalAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"
                                    Command="{Binding CalculateFittingCommand}"
                                    Margin="0,0,8,0" Height="32" Padding="8,0"
                                    Visibility="{Binding CanSaveCurve, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="更新拟合" Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Style="{StaticResource MaterialDesignRaisedLightButton}"
                                    Command="{Binding SaveCurrentCurveCommand}"
                                    Height="32" Padding="12,0"
                                    Visibility="{Binding CanSaveCurve, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="保存曲线" Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 第二行：指标展示区 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,0,0">
                            <TextBlock Text="拟合方程" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding EquationText}" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="相关系数 (R²)" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding RSquaredText}" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="检出限 (LOD)" FontSize="11" Opacity="0.7"/>
                            <TextBlock FontSize="18" FontWeight="Bold">
                                <Run Text="{Binding LodValue, StringFormat={}{0:F3}}" />
                                <Run Text=" " />
                                <Run Text="{Binding DisplayUnit}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ================= 右侧列 (数据表格) ================= -->
        <Grid Grid.Column="1" Margin="6,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 上半部分：标准点表格 -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <!-- 遮罩层，历史曲线模式下显示 -->
                    <Border Background="#CCFFFFFF" Panel.ZIndex="5" 
                            Visibility="{Binding CanSaveCurve, Converter={StaticResource InverseBoolToVisConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="32" Height="32" HorizontalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="当前配置为使用 [历史保存曲线]" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" HorizontalAlignment="Center" Opacity="0.8"/>
                            <TextBlock Text="直接利用底层存储公式计算待测样品浓度" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                            <TextBlock Text="(无需重新进行标准点拟合)" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 遮罩层，没有标液时显示 -->
                    <Border Background="#CCFFFFFF" Panel.ZIndex="6" 
                            Visibility="{Binding HasStandardSamples, Converter={StaticResource InverseBoolToVisConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartBoxOutline" Width="32" Height="32" HorizontalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="暂无校准点数据" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" HorizontalAlignment="Center" Opacity="0.8"/>
                            <TextBlock Text="请在序列中添加标准溶液后查看" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="校准点数据" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Margin="0,0,0,8" Opacity="0.6"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding StandardPoints}" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="标准品名称" Binding="{Binding Name}" Width="1.5*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="已知浓度" Binding="{Binding Concentration}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="响应强度" Binding="{Binding Intensity, StringFormat={}{0:F0}}" Width="*" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="启用" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBlank}" Value="True">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- 2. 下半部分：样品测定结果明细 -->
            <materialDesign:Card Grid.Row="1" Margin="0,0,0,8" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <!-- 遮罩层，没有待测样品时显示 -->
                    <Border Background="#CCFFFFFF" Panel.ZIndex="5" 
                            Visibility="{Binding HasUnknownSamples, Converter={StaticResource InverseBoolToVisConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="FlaskEmptyOutline" Width="32" Height="32" HorizontalAlignment="Center" Opacity="0.6"/>
                            <TextBlock Text="暂无待测样品数据" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" HorizontalAlignment="Center" Opacity="0.8"/>
                            <TextBlock Text="请在左侧测量完成后查看分析结果" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="FormatListBulleted" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="{Binding SelectedElement, StringFormat='待测样品分析结果 - {0}'}" 
                                       FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.6"/>
                        </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredResults}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="1.5*"/>
                            <DataGridTextColumn Header="测量强度" Binding="{Binding Intensity, StringFormat={}{0:F0}}" Width="*"/>
                            <DataGridTextColumn Header="相对偏差" Binding="{Binding RSD, StringFormat=± {0:F2}%}" Width="0.8*"/>
                            <DataGridTextColumn Header="算得浓度" Binding="{Binding CalculatedConc}" 
                                                Width="*" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- 3. 底部操作按钮 -->
            <materialDesign:Card Grid.Row="2" UniformCornerRadius="8" Padding="12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="导出详细数据" Command="{Binding GenerateZipReportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0"/>
                    <Button Content="导出报告" Command="{Binding GenerateReportCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1E88E5" BorderBrush="#1E88E5"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
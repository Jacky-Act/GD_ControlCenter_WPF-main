<UserControl x:Class="GD_ControlCenter_WPF.Views.Pages.SampleMeasurementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:helpers="clr-namespace:GD_ControlCenter_WPF.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1366">

    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <!-- 1. 序列 -->
            <ColumnDefinition Width="5*" />
            <!-- 2. 图表 -->
            <ColumnDefinition Width="2.8*" />
            <!-- 3. 控制 -->
        </Grid.ColumnDefinitions>

        <!-- ================= 1. 左侧：序列 ================= -->
        <materialDesign:Card Grid.Column="0" Margin="5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding SequenceTitle}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Opacity="0.6"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding MeasurementSequence}" SelectedItem="{Binding CurrentSample}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          IsEnabled="{Binding IsCollecting, Converter={StaticResource InverseBoolConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="采集数据中...">
                                            <Setter Property="Foreground" Value="Orange"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="已完成">
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="样品名称" Binding="{Binding SampleName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- ================= 2. 中间：双图 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 上图：全谱 -->
            <materialDesign:Card Grid.Row="0" Margin="2.5,5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <TextBlock Text="实时全谱监控 (Full Spectrum)" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,10" Opacity="0.5" Style="{StaticResource MaterialDesignSubtitle2TextBlock}"/>
                    <ScottPlot:WpfPlot x:Name="SpecPlot" Margin="5,35,5,5"/>
                </Grid>
            </materialDesign:Card>

            <!-- 下图：趋势 -->
            <materialDesign:Card Grid.Row="1" Margin="2.5,5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <TextBlock Text="测量强度趋势 (Intensity Trend)" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,10" Opacity="0.5" Style="{StaticResource MaterialDesignSubtitle2TextBlock}"/>
                    <ScottPlot:WpfPlot x:Name="TrendPlot" Margin="5,35,5,5"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ================= 3. 右侧：结果与控制 ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 样品信息 -->
            <materialDesign:Card Margin="5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 行0：样品名称 (左) 和 积分时间 (右) -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding CurrentSample.SampleName, FallbackValue='未选择'}" FontSize="24" FontWeight="Bold"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="积分时间: " FontSize="14" Opacity="0.6"/>
                        <TextBlock Text="{Binding CurrentMeasurementGroup.IntegrationTime, FallbackValue='--'}" FontSize="14" FontWeight="Bold" Margin="2,0,0,0"/>
                        <TextBlock Text=" ms" FontSize="14" Opacity="0.6"/>
                    </StackPanel>

                    <!-- 行1：样品类型 (左) 和 平均次数 (右) -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CurrentSample.Type}" FontSize="14" Opacity="0.8" Margin="0,5,0,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,5,0,0">
                        <TextBlock Text="平均次数: " FontSize="14" Opacity="0.6"/>
                        <TextBlock Text="{Binding CurrentMeasurementGroup.AverageCount, FallbackValue='--'}" FontSize="14" FontWeight="Bold" Margin="2,0,0,0"/>
                    </StackPanel>

                    <!-- 行2：当前测量的元素列表（竖向，双列，带滑动条） -->
                    <ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" MaxHeight="80" Margin="0,15,0,0">
                        <ItemsControl ItemsSource="{Binding CurrentMeasurementGroup.Elements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="13" Margin="0,2,10,2" Opacity="0.8" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <!-- 结果表格 -->
            <materialDesign:Card Grid.Row="1" Margin="5" UniformCornerRadius="8">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="测量强度" FontWeight="Bold" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CurrentSample.ElementConcentrations}"
                                  SelectedItem="{Binding SelectedPreviewElement}"
                                  DisplayMemberPath="ElementName"
                                  materialDesign:HintAssist.Hint="切换元素"
                                  Width="160"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 动态测样列表 -->
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedPreviewElement.Reps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="4" 
                                            Background="{DynamicResource MaterialDesignPaper}"
                                            BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                        <Grid>
                                            <TextBlock Text="{Binding RepIndex}" 
                                                       FontWeight="Bold" Opacity="0.7" VerticalAlignment="Center"/>
                                            
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <ProgressBar x:Name="MeasuringProgress" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                                             Value="0" IsIndeterminate="True" 
                                                             Width="16" Height="16" Margin="0,0,10,0"
                                                             Visibility="Collapsed"/>
                                                
                                                <!-- TargetNullValue 绑定不支持的话可以直接写在StringFormat，但空值直接留白即可。为了有占位符： -->
                                                <TextBlock x:Name="ValueText" Text="{Binding Intensity, StringFormat={}{0:F0}, TargetNullValue='--'}" 
                                                           FontSize="16" FontWeight="Bold" 
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMeasuring}" Value="True">
                                            <Setter TargetName="MeasuringProgress" Property="Visibility" Value="Visible"/>
                                            <!-- 测量中时如果需要数值高亮也可以在这里写 -->
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 底部统计 -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="平均强度：" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding SelectedPreviewElement.MeasuredIntensity, StringFormat='{}{0:F0}', Mode=OneWay}" 
                                         IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                         FontWeight="Bold" VerticalAlignment="Center" Padding="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="RSD：" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding SelectedPreviewElement.MeasuredRsd, StringFormat='{}{0:F2}%', Mode=OneWay}" 
                                         IsReadOnly="True" BorderThickness="0" Background="Transparent" 
                                         FontWeight="Bold" VerticalAlignment="Center" Padding="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <!-- 操作按钮区 -->
            <materialDesign:Card Grid.Row="2" Margin="5" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp3">
                <StackPanel Margin="10">
                    <!-- 1. 核心采集按钮 (动态切换颜色和文字) -->
                    <Button Height="70" FontSize="20" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Content" Value="开始采集数据"/>
                                <Setter Property="Command" Value="{Binding StartCollectingCommand}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollecting}" Value="True">
                                        <Setter Property="Content" Value="中止采集"/>
                                        <Setter Property="Background" Value="IndianRed"/>
                                        <Setter Property="BorderBrush" Value="IndianRed"/>
                                        <Setter Property="Command" Value="{Binding StopSequenceCommand}"/>
                                    </DataTrigger>
                                    
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCollecting}" Value="False"/>
                                            <Condition Binding="{Binding StartCollectingCommand.IsRunning}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Content" Value="正在中止..."/>
                                        <!-- Keep the button grey and disabled looking while it's stopping -->
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>